# Test MBDyn file for Genetic Algorithm Optimization Module
# Based on user's test syntax

begin: data;
	problem: initial value;
end: data;

begin: initial value;
	initial time: 0.;
	final time: 10.;
	time step: 1.e-3;

	tolerance: 1e-9;
	max iterations: 10;

	method: ms, .6;
end: initial value;

begin: control data;
	structural nodes:
		+1	# ground
		+6	# test nodes
	;
	joints:
		+5	# test joints
	;
	loadable elements: 1;  # GA optimization element

	output results: netcdf;
end: control data;

reference: 0,
	reference, global, null,
	reference, global, eye,
	reference, global, null,
	reference, global, null;

begin: nodes;
	structural: 0, static,
		reference, 0, null,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
	
	# Test nodes for the optimization
	structural: 121, dynamic,
		reference, 0, 1., 0., 0.,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
	
	structural: 123, dynamic,
		reference, 0, 2., 0., 0.,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
	
	structural: 126, dynamic,
		reference, 0, 3., 0., 0.,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
	
	structural: 130, dynamic,
		reference, 0, 4., 0., 0.,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
	
	structural: 131, dynamic,
		reference, 0, 5., 0., 0.,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
	
	structural: 132, dynamic,
		reference, 0, 6., 0., 0.,
		reference, 0, eye,
		reference, 0, null,
		reference, 0, null;
end: nodes;

begin: elements;
	# Create some test joints to provide moment data
	joint: 101, total joint,
		121,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		0,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		position constraint, 1, 1, 1, null,
		orientation constraint, 0, 0, 1, 
			component, 
				const, 0.,
				const, 0.,
				sine, 0., 2.*pi, 1., forever, 0.;

	joint: 102, total joint,
		123,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		0,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		position constraint, 1, 1, 1, null,
		orientation constraint, 0, 0, 1, 
			component, 
				const, 0.,
				const, 0.,
				cosine, 0., 2.*pi, 1.5, forever, 0.;

	joint: 103, total joint,
		130,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		0,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		position constraint, 1, 1, 1, null,
		orientation constraint, 0, 0, 1, 
			component, 
				const, 0.,
				const, 0.,
				ramp, 0.5, 0., 1., forever, 0.;

	joint: 104, total joint,
		131,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		0,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		position constraint, 1, 1, 1, null,
		orientation constraint, 0, 0, 1, 
			component, 
				const, 0.,
				const, 0.,
				step, 1., 2., forever, 0.;

	joint: 105, total joint,
		132,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		0,
			position, reference, 0, null,
			position orientation, reference, 0, eye,
			rotation orientation, reference, 0, eye,
		position constraint, 1, 1, 1, null,
		orientation constraint, 0, 0, 1, 
			component, 
				const, 0.,
				const, 0.,
				exponential, 2., 0.1, forever, 0.;

	# Load the GA optimization module
	# module load: "libmodule-GeneticAlgorithm";

	# GA Optimization Element - matches user's test syntax
	user defined: 1000, genetic algorithm optimization,
		inputs number, 5,
			element, 101, joint, string, "M[2]", direct,
			element, 102, joint, string, "M[2]", direct,
			element, 103, joint, string, "M[2]", direct,
			element, 104, joint, string, "M[2]", direct,
			element, 105, joint, string, "M[2]", direct,
		genetic algorithm: libga.so,
		constraint function: libcons.so,
		population, 50,
		generation, 100,
		output number, 3,
			121,
			123,
			126;

	# Output the GA element to see results
	output: loadable, 1000;

	# Example: Use GA outputs to drive forces (optional)
	/*
	force: 200, absolute,
		121,
			position, reference, node, null,
		1., 0., 0.,
			element, 1000, loadable, string, "output[1]", linear, 0., 1.;

	force: 201, absolute,
		123,
			position, reference, node, null,
		0., 1., 0.,
			element, 1000, loadable, string, "output[2]", linear, 0., 1.;

	force: 202, absolute,
		126,
			position, reference, node, null,
		0., 0., 1.,
			element, 1000, loadable, string, "output[3]", linear, 0., 1.;
	*/
end: elements;

# vim:ft=mbd